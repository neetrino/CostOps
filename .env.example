# Application
NODE_ENV="development"
APP_URL="http://localhost:3000"
LOG_LEVEL="info"

# Database — local or Neon DEV branch only. Never production URLs on a laptop.
DATABASE_URL=""
DIRECT_URL=""
DATABASE_CONNECTION_LIMIT="5"
DATABASE_POOL_TIMEOUT="20"
DATABASE_STATEMENT_TIMEOUT_MS="30000"

# Dashboard auth (required in production)
DASHBOARD_PASSWORD=""
JWT_SECRET=""

# Cron / internal jobs (min 16 chars)
CRON_SECRET=""

# Neon Console API — same names as neetrino/neon
NEON_API_KEY=""
NEON_ORG_ID=""
NEON_PRICING_PLAN="launch"

# Telegram (optional locally; alerts skipped if empty)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_SPEND_ALERT_DEFAULT_USD="1"
SPEND_ALERT_ESCALATION_PERCENT_OF_THRESHOLD="30"

# Vercel adapter (Phase 2)
VERCEL_API_TOKEN=""
VERCEL_TEAM_ID=""

# Upstash Management API (Phase 4) — Account → Management API
# https://console.upstash.com/account/api
UPSTASH_EMAIL=""
UPSTASH_API_KEY=""

# GCP Cloud Billing (Phase 4) — paste when ready
GCP_PROJECT_ID=""
GCP_BILLING_ACCOUNT_ID=""
GOOGLE_APPLICATION_CREDENTIALS=""

# Read-only Postgres of https://github.com/neetrino/neon (live dashboard history).
# Used only by scripts/migrate-from-neon.ts to copy snapshots/thresholds into CostOps.
# Never use as CostOps DATABASE_URL. Never migrate or write this database.
# See docs/OLD_NEON_DATABASE.md
OLD_NEON_PROJECT_DATABASE_URL=""