# Application
NODE_ENV="development"
APP_URL="http://localhost:3000"
LOG_LEVEL="info"

# Database — local or Neon DEV branch only. Never production URLs on a laptop.
DATABASE_URL=""
DIRECT_URL=""
DATABASE_CONNECTION_LIMIT="5"
DATABASE_POOL_TIMEOUT="20"
DATABASE_STATEMENT_TIMEOUT_MS="30000"

# Dashboard auth (required in production)
DASHBOARD_PASSWORD=""
JWT_SECRET=""

# Cron / internal jobs (min 16 chars)
CRON_SECRET=""

# Neon adapter (credentialRef=NEON_PRIMARY)
NEON_PRIMARY_API_KEY=""
NEON_PRIMARY_ORG_ID=""
NEON_PRICING_PLAN="launch"

# Legacy aliases accepted until ProviderAccount wiring lands (Phase 1)
NEON_API_KEY=""
NEON_ORG_ID=""

# Telegram (optional locally; alerts skipped if empty)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_SPEND_ALERT_DEFAULT_USD="1"
SPEND_ALERT_ESCALATION_PERCENT_OF_THRESHOLD="30"

# Vercel adapter (Phase 2)
VERCEL_PRIMARY_API_TOKEN=""
VERCEL_PRIMARY_TEAM_ID=""
